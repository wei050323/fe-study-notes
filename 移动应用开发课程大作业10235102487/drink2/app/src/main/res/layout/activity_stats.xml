<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/page_background"
        android:title="统计"
        app:navigationIcon="@android:drawable/ic_media_previous"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_stats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@id/toolbar_stats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_today_summary"
            style="@style/Card.Elevated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_16">

                <TextView
                    android:id="@+id/text_today_title"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日摘要" />

                <TextView
                    android:id="@+id/text_today_caffeine"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="咖啡因 220mg / 400mg"
                    android:layout_marginTop="@dimen/spacing_8"
                    app:layout_constraintTop_toBottomOf="@id/text_today_title"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_today_status"
                    style="@style/Text.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="在安全范围内"
                    android:layout_marginTop="@dimen/spacing_4"
                    app:layout_constraintTop_toBottomOf="@id/text_today_caffeine"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text_week_title"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近7天咖啡因摄入"
            android:layout_marginTop="@dimen/spacing_24"
            app:layout_constraintTop_toBottomOf="@id/card_today_summary"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/layout_bar_chart"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_16"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/text_week_title"
            app:layout_constraintBottom_toTopOf="@id/text_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_hint"
            style="@style/Text.BodySecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="建议每日咖啡因摄入不超过 400mg"
            android:layout_marginTop="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

